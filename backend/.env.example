PORT=4000
# Локално: Hardhat node. За Polygon Amoy: https://rpc-amoy.polygon.technology
RPC_URL=http://127.0.0.1:8545
# Приватен клуч на оракулот (адресата мора да има ORACLE_ROLE во договорот).
# Стандардната вредност е Hardhat сметка #1 – никогаш не ја користи надвор од локален развој.
ORACLE_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# Клуч за админ/оракул повиците од frontend-от
ORACLE_API_KEY=dev-oracle-key
TZ_NAME=Europe/Skopje
CRON_ENABLED=true
CRON_SCHEDULE=15 9 * 2-4 *
AUTO_CLAIM=true
CORS_ORIGIN=*
